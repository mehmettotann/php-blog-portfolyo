# =========================================================
# Kişisel Blog & Dijital Portfolyo — Örnek Ortam Ayarları
# Kurulum için bu dosyayı `.env` adıyla kopyalayıp düzenleyin:
#   cp .env.example .env
# =========================================================

APP_NAME="Adınız Soyadınız"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Europe/Istanbul

# MySQL Veritabanı Ayarları
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blog_portfolio
DB_USERNAME=db_user
DB_PASSWORD=your_secure_password

# Yükleme Limitleri (MB) — php.ini upload_max_filesize / post_max_size ile uyumlu olmalı
MAX_IMAGE_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=95

# LiteSpeed Cache (Canlı LiteSpeed/cPanel/Plesk sunucuda true yapın)
LITESPEED_CACHE_ENABLED=false
LITESPEED_CACHE_TTL=3600

# İlk Kurulum Yönetici Hesabı (database/install.php içindir; kurulum sonrası panelden değiştirin)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=ChangeMe2026!
