# =========================================================================
# /uploads/.htaccess — Yüklenen Medya Klasörü Güvenliği
# Bu klasörde PHP veya herhangi bir betik dosyasının çalıştırılmasını engeller.
# =========================================================================

Options -Indexes -ExecCGI

<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
    RemoveType .php .phtml .phar
</IfModule>

<FilesMatch "\.(php|php\d|phtml|phar|cgi|pl|py|rb|sh|htaccess|ini|env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    <FilesMatch "\.(mp4|webm)$">
        Header set Accept-Ranges "bytes"
    </FilesMatch>
</IfModule>
